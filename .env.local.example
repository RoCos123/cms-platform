# Copiază în .env.local (gitignorat) și completează cu valorile reale.
# Vezi decizii-faza-0.md pentru raționamentul din spatele fiecărei decizii.

# --- Supabase (Project Settings -> API în dashboard-ul Supabase) ---
# Terminologia curentă Supabase e "Publishable key" / "Secret key" — proiectele
# mai vechi le arată ca "anon key" / "service_role key". E aceeași pereche.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. NU prefixa cu NEXT_PUBLIC_ — ocolește complet RLS.
# OBLIGATORIE: rolul `anon` nu mai are acces la niciun tabel (vezi migrarea
# 20260825140000_harden_rls.sql), deci rezolvarea tenantului și citirea
# datelor pentru site-urile publice se fac server-side cu această cheie.
SUPABASE_SECRET_KEY=

# --- Rezolvarea tenantului în dev local (src/proxy.ts) ---
# Fără subdomeniu platformă, localhost n-are niciun tenant "gratuit" de testat.
# Pune aici domeniul unui site seedat manual în tabelul `sites`.
DEV_TENANT_DOMAIN=

# --- Teste RLS (e2e/tenant-rls.spec.ts) — 2 useri creați manual în Supabase
# Auth (Dashboard -> Authentication -> Users), vezi supabase/seed-test-tenants.sql
TEST_TENANT_A_EMAIL=
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_EMAIL=
TEST_TENANT_B_PASSWORD=

# --- Email tranzacțional (notificări contact + confirmări programări) ---
RESEND_API_KEY=

# --- Anti-spam pe formularele publice ---
# Furnizorul casetei: `hcaptcha` (implicit) sau `turnstile`. Lăsat gol înseamnă
# hCaptcha. NU trece pe Turnstile pentru o platformă cu mai multe cabinete:
# Turnstile acceptă cel mult 10 domenii pe cheie și 20 de chei pe cont — 200 de
# domenii cu totul — iar peste ele urmează un plan de la 2.000 $/lună. hCaptcha
# n-are plafonul: aceeași pereche de chei merge pe oricâte domenii, fără ca un
# client nou să fie înregistrat undeva. Vezi src/lib/captcha.ts.
NEXT_PUBLIC_CAPTCHA_FURNIZOR=
# O singură pereche pentru toată platforma. Cheia publică ajunge oricum în
# pagină; secretul stă doar aici.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
